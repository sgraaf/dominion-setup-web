{
  "name": "dominion-setup-web",
  "version": "0.0.0",
  "private": true,
  "description": "Set up a game of Dominion in your browser, with dominion-setup running in Pyodide.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "sync-wheel": "uv run scripts/sync_wheel.py",
    "dev": "npm run sync-wheel && vite",
    "build": "npm run sync-wheel && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "comlink": "^4.4.2",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
