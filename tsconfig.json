{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*", "tests/e2e/**/*", "*.config.ts", "*.config.js"]
}
